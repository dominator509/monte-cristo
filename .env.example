# MONTE CRISTO -- environment template.
# Copy to .env and fill every REQUIRED value, then run: sh scripts/preflight.sh
# .env is gitignored and must never be committed. This project has no secrets; every value
# below is a path, a version string, or a mode flag.

# Path to the RON content source tree that the bake step reads.
# Must exist and be writable. Confined root: nothing outside this path is ever read as content.
MC_CONTENT_DIR=./content

# Path where release tarballs and SHA256SUMS are staged by EP-009 and EP-010.
# Must exist and be writable.
MC_ARTIFACT_DIR=./target/artifacts

# Path for saves, settings, logs, and local crash reports at runtime and under test.
# Must exist and be writable. Confined root: the game never writes outside this path.
MC_DATA_DIR=./.local-data

# Exact pinned Rust toolchain version. Must match rust-toolchain.toml.
MC_RUST_VERSION=1.83.0

# Comma-separated pinned versions of the required cargo subcommands, in this exact order:
# cargo-deny,cargo-fuzz,cargo-llvm-cov
MC_CARGO_TOOLS=0.16.2,0.12.0,0.6.15

# Expected platform graphics stack for building mc_shell. One of: x11, wayland, macos, mingw
MC_GRAPHICS_STACK=x11

# Crate registry mode. Exactly one of: online, vendored
CARGO_REGISTRY_MODE=online

# Short free-text identifier of the machine the performance budgets are measured against.
# Recorded into the bench report so a budget failure can be attributed.
MC_REFERENCE_MACHINE=changeme-reference-host

# Must be exactly 1 in every scripted gate so mc_shell never opens a window in automation.
MC_HEADLESS=1
